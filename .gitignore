#
# Development artifacts
#
*.sw[onp]
/.claude
.DS_Store
/.agents/worktrees/

# Local operator credentials for infrastructure maintenance. Server
# configuration remains explicit ORBITA_* environment variables; this file is
# only a local source for provider credentials and must never be committed.
/.env

#
# Rust build output
#
/target
**/*.rs.bk

#
# moon's task cache and generated schemas. The configuration under .moon is
# committed; everything it writes at runtime is not.
#
/.moon/cache
/.moon/docker

#
# Coverage output. `cargo llvm-cov` writes a raw profile per test process,
# named from the profile-file pattern rather than from the target directory,
# so these land in whichever crate directory the process ran in and escape
# the /target rule above. Unanchored for the same reason.
#
*.profraw
*.profdata
/codecov.json

#
# Local cluster scratch data
#
/data
/devdata
/.orbita
