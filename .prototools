# Pins the version of moon, so `proto install moon` in a fresh checkout gets
# the one CI runs. Keep it in step with `moon-version` in
# .github/workflows/ci.yml: moonrepo/setup-toolchain does not read this file,
# it installs whatever you pass it, so the two are written down separately.
# They fail loudly rather than quietly when they disagree, because a moon that
# does not match this repo's config errors on the first parse.
#
# Rust is deliberately not listed here. rust-toolchain.toml pins the compiler
# and rustup installs it, and routing that through proto instead means two
# installers for one version. Note that proto reads rust-toolchain.toml as a
# version file on its own, which is why `proto use` is the wrong command here
# and `proto install moon` is the right one.
moon = "2.4.6"
